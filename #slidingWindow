'''
give an array: prices

prices[i] is the stock price on the day 

when to buy 
when to sell

return the max profit possible


ex)  prices = [7,1,5,3,6,4] ---> 5

buy at 1, sell at 6 
'''


def function(arr):

    left = 0 #the day you buy (starting it at index 0)
    max_profit = 0

    for right in range(len(arr)):
        #this will go through all of the array i think 
        # expand the window by including arr[right]

        if arr[left] > arr[right]:
            #if left is more than right 
            #then we found a new lower 

            # shrink the window from the left
            left = right 
            #placing left on the new lower
        else:
            profit = arr[right] - arr[left]
            if profit > max_profit:
                max_profit = profit

    return max_profit
        

