def fucntionkkk (s):



    left = 0 #so that it can be moved
    seen = set() 


    max_length = 0

    #right is  a value (a number)
    #char is a variable within in enumerate(s)
    for right, char in enumerate(s):
        while char in seen: #using a while instead of an if 
            seen.remove(s[left])
            left+=1 #updating the left++

#once that while loop is done
#we go back to adding to set()
        seen.add(char)

#once added to set()
#we calculate 

#using the right and left 
#having a plus one counting for the fact that we starte at 0

#we do the math for the new_window

#if statement where we compare the max_lenght vs the new window
#reassign if needed




        new_window = right - left+1
        if max_length < new_window:
            max_length = new_window
            

#once we have gone through all of the string 
#we return the max_length 
#once reached the end of the string we return what we have 

    return max_length



